rules_version = '2';

// A Lab Murder: public by design (no auth, no passwords).
// These are explicit open rules for the four collections the app uses.
// Unlike "test mode" they do not expire after 30 days.
// Everything else in the database stays locked.
service cloud.firestore {
  match /databases/{database}/documents {
    match /game/{docId} {
      allow read, write: if true;
    }
    match /votes/{deviceId} {
      allow read, write: if true;
    }
    match /voteLog/{entryId} {
      allow read, write: if true;
    }
    match /characters/{characterId} {
      allow read, write: if true;
    }
  }
}
